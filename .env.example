# =============================================================================
# HXP Trip Sign-Up — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit real secrets.
# =============================================================================

# ---- Persistence: Supabase (optional) --------------------------------------
# Create a Supabase project and a `signups` table (schema in README).
# The SERVICE ROLE key is SERVER-ONLY. It must NOT be prefixed NEXT_PUBLIC_.
# If these are unset, the endpoint still validates + rate-limits, but writes
# to a local dev log instead of a database (see README "Persistence").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Spam / abuse: Cloudflare Turnstile (optional but recommended) ---------
# Free CAPTCHA-alternative. Site key is public; secret key is server-only.
# If unset, Turnstile is skipped — honeypot + rate limiting stay active.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Rate limiting ---------------------------------------------------------
# Max submissions per IP per window. Sensible defaults applied if unset.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600
